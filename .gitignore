# Keep templates/scaffold source but ignore symlinked clones (canonical is skills/)
# .claude/.codex/.opencode/.agents are symlinks -> ../../skills/bantingan-php-app
# Do not ignore them, but ignore their caches
.opencode/node_modules/
.opencode/package-lock.json

